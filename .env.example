# 실제 값은 저장하지 않는다. 이 파일은 필요한 키의 목록만 알린다.
#
#   호스트 실행 : C:\Users\lee21\lakehouse\.env  (자동 로드)
#   컨테이너   : docker-compose 환경변수 또는 Airflow Variable

# ── Databricks ────────────────────────────────────────────────────
# Free Edition SQL Warehouse 토큰. 마우스 오버 → 쿼리 편집기 우측 톱니바퀴 →
# 연결 세부 정보 → 토큰 생성.
DATABRICKS_TOKEN=
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=

# ── 원천 DB ───────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── S3 ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PREFIX=pretest

# ── rclone 원격제어(rcd) ───────────────────────────────────────────
# 셸 명령이 아니라 HTTP API 로 복제하므로 rcd 포트(기본 5572)와 인증이 필요하다.
# 리모트 이름은 하이픈이 아니라 **밑줄**이어야 한다.
# (RCLONE_CONFIG_<이름>_TYPE 환경변수는 하이픈을 밑줄로 바꾼다)
RCLONE_RC_USER=
RCLONE_RC_PASS=
RCLONE_RC_URL=http://rclone-rcd:5572
RCLONE_REMOTE=lakehouse_seoul

# ── Slack ─────────────────────────────────────────────────────────
# ⚠ Incoming Webhook URL 은 **비밀번호와 같은 자격증명**이다.
#   anyone 이면 채널에 아무나 쓸 수 있고, Git 에 들어가면 이력에서 지우기
#   어렵다. 그래서 `.env`(커밋 제외)에만 적고 절대 커밋하지 않는다.
#
#   발급 방법
#     https://api.slack.com/apps → Create New App → From scratch
#     → 워크스페이스 선택 → Incoming Webhooks 활성화 → Add New Webhook
#     → 대상 채널 선택 → Copy → 값을 .env 의 SLACK_WEBHOOK_URL 에 붙여넣기
#
#   유출 시
#     위 화면에서 해당 웹훅을 삭제하고 새로 만든다. 이력에서 지웠다고
#     안전해지지 않는다.
#
#   참고: Incoming Webhook 은 채널이 고정이라 메시지마다 채널을 지정할
#   수 없다. 그래서 발송 기록(work/slack_sent.json)으로 확인한다.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ID=

# ── 메일 (매뉴얼 발송) ────────────────────────────────────────────
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=mercy.lee@kakaopaycorp.com